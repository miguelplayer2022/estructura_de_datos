package inventario;


public class Producto {
    private int ID;
    private String name;
    private int existence;
    private double price;
    
    // consultar para buscar por ID

    public Producto(int ID) {
        this.ID = ID;
    }
    
    // cosntructor para crear un producto completo

    public Producto(int ID, String name, int existence, double price) {
        this.ID = ID;
        this.name = name;
        this.existence = existence;
        this.price = price;
    }
    
    // get: permite consultar los datos 

    public int getID() {
        return ID;
    }

    public String getName() {
        return name;
    }

    public int getExistence() {
        return existence;
    }

    public double getPrice() {
        return price;
    }
    
    // set: permite modificar los datos

    public void setID(int ID) {
        this.ID = ID;
    }

    public void setName(String name) {
        this.name = name;
    }

    public void setExistence(int existence) {
        this.existence = existence;
    }

    public void setPrice(double price) {
        this.price = price;
    }
    
    // comparar los productos 

    

    @Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }
        if (obj == null) {
            return false;
        }
        if (getClass() != obj.getClass()) {
            return false;
        }
        final Producto other = (Producto) obj;
        return this.ID == other.ID;
    }
    
    // permite mostras los datos del producto

    public String mostrasinfo() {
        return "Producto: " + "ID=" + ID + ", name=" + name + ", existence=" + existence + ", price=" + price + '.';
    }
    
    
    
    
    
    
    
}
